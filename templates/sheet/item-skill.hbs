<section class="pg-sheet pg-item-dossier pg-passport pg-passport--skill">
  <div class="sheet-body">
    <div class="pg-blueprint pg-blueprint--passport">
      <div class="pg-blueprint__zones" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span></div>
      <div class="pg-blueprint__margin" aria-hidden="true"><span>Инв. № подл.</span><span>Подп. и дата</span></div>

      <header class="pg-passport__header">
        <div class="pg-passport__kicker"><span>Паров-Град</span><i class="fa-solid fa-gear" aria-hidden="true"></i><span>Наставление · Навык</span></div>
        <div class="pg-passport__figure">
          <button type="button" class="pg-item-portrait-edit" title="Изменить изображение" aria-label="Изменить изображение: {{document.name}}" {{#unless canEditPortrait}}disabled{{/unless}}>
            <img src="{{document.img}}" alt="{{document.name}}">
          </button>
          <span class="pg-passport__dim pg-passport__dim--h" aria-hidden="true">М 1:1</span>
          <span class="pg-passport__dim pg-passport__dim--v" aria-hidden="true"></span>
          <span class="pg-passport__stamp {{#if isEditMode}}is-draft{{/if}}" aria-hidden="true">{{#if isEditMode}}Черновик{{else}}Утверждено{{/if}}</span>
        </div>
        <div class="pg-passport__title">
          <h1>{{document.name}}</h1>
          <p class="pg-passport__lead"><span>Урон: <strong>{{#if damageSummary}}{{damageSummary}}{{else}}—{{/if}}</strong></span><span>Изучение: <strong>{{skillView.cost}} ОН</strong></span></p>
          <div class="pg-passport__controls">
            {{#if passport.canToggleMode}}
            <button type="button" class="pg-mode-toggle" aria-pressed="{{#if isEditMode}}true{{else}}false{{/if}}">
              {{#if isEditMode}}<i class="fa-solid fa-check" aria-hidden="true"></i> Готово{{else}}<i class="fa-solid fa-pen-ruler" aria-hidden="true"></i> Править{{/if}}
            </button>
            {{/if}}
          </div>
        </div>
      </header>

      <div class="pg-passport__body">
        {{#if isEditMode}}
        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Основные данные</h2>
          <div class="pg-form-grid pg-form-grid--two-columns">
            <div class="pg-form-field">
              <label for="pg-skill-name-{{document.id}}">Название</label>
              <input id="pg-skill-name-{{document.id}}" type="text" name="name" value="{{document.name}}" />
            </div>
            <div class="pg-form-field">
              <label for="pg-skill-cost-{{document.id}}">Стоимость изучения (очки навыков)</label>
              <input id="pg-skill-cost-{{document.id}}" type="number" name="system.cost" min="0" step="1" value="{{system.cost}}" />
            </div>
          </div>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Шаблон области</h2>
          <div class="pg-spell-template-panel">
            <div class="pg-spell-template-panel__header">
              <div>
                <strong>Размещение на сцене</strong>
                <span>При применении навыка шаблон размещается на сцене и выбирает токены, центр которых попал в область.</span>
              </div>
              <label class="pg-spell-template-toggle">
                <input type="checkbox" name="system.template.enabled" {{checked skillTemplate.enabled}} />
                Использовать
              </label>
            </div>

            <div class="pg-form-grid pg-form-grid--two-columns">
              <div class="pg-form-field">
                <label for="pg-skill-template-type-{{document.id}}">Тип шаблона</label>
                <select id="pg-skill-template-type-{{document.id}}" name="system.template.type">
                  {{#each skillTemplate.typeOptions}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="pg-form-field">
                <label for="pg-skill-template-distance-{{document.id}}">{{skillTemplate.distanceLabel}}</label>
                <input id="pg-skill-template-distance-{{document.id}}" type="number" name="system.template.distance" min="0" step="1" value="{{skillTemplate.distance}}" />
              </div>

              {{#if skillTemplate.usesWidth}}
                <div class="pg-form-field">
                  <label for="pg-skill-template-width-{{document.id}}">Ширина линии</label>
                  <input id="pg-skill-template-width-{{document.id}}" type="number" name="system.template.width" min="0" step="1" value="{{skillTemplate.width}}" />
                  <p class="pg-form-hint">0 — ширина одной клетки текущей сцены.</p>
                </div>
              {{/if}}

              {{#if skillTemplate.usesAngle}}
                <div class="pg-form-field">
                  <label for="pg-skill-template-angle-{{document.id}}">Угол конуса</label>
                  <input id="pg-skill-template-angle-{{document.id}}" type="number" name="system.template.angle" min="1" max="360" step="1" value="{{skillTemplate.angle}}" />
                </div>
              {{/if}}
            </div>

            <p class="pg-form-hint">Размеры задаются в единицах дистанции сцены. Для квадрата указанная величина считается длиной стороны.</p>
          </div>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Урон</h2>
          <div class="pg-form-field pg-damage-editor">
            <p class="pg-form-hint">Выберите дробящий, колющий, режущий или другой тип урона. Для смешанного урона добавьте компонент.</p>
            {{#each damageParts}}
              <div class="pg-damage-row" data-damage-index="{{@index}}">
                <input class="pg-damage-formula" type="text" value="{{this.formula}}" placeholder="1d8" title="Формула урона" aria-label="Формула урона" />
                <select class="pg-damage-type" aria-label="Тип урона">
                  {{#unless this.damageType}}<option value="" selected disabled>— Выберите тип —</option>{{/unless}}
                  {{#each this.damageTypeOptions}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
                <button type="button" class="pg-damage-delete" title="Удалить компонент" aria-label="Удалить компонент урона">×</button>
              </div>
            {{/each}}
            <button type="button" class="pg-damage-add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить компонент</button>
          </div>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Дополнительный эффект</h2>
          <div class="pg-form-field">
            <label for="pg-skill-die-{{document.id}}">Куб проверки доп. эффекта</label>
            <select id="pg-skill-die-{{document.id}}" name="system.effectCheckDie">
              {{#each effectDieOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            <p class="pg-form-hint">После успешной атаки и броска урона можно отдельно проверить дополнительный эффект по диапазону.</p>
          </div>

          <div class="pg-range-composer">
            <div class="pg-form-field">
              <label for="pg-skill-range-from-{{document.id}}">От</label>
              <input id="pg-skill-range-from-{{document.id}}" type="number" class="pg-weapon-effect-add-from" min="1" step="1" value="1" />
            </div>
            <div class="pg-form-field">
              <label for="pg-skill-range-to-{{document.id}}">До</label>
              <input id="pg-skill-range-to-{{document.id}}" type="number" class="pg-weapon-effect-add-to" min="1" step="1" value="1" />
            </div>
            <div class="pg-form-field pg-range-composer__text">
              <label for="pg-skill-range-text-{{document.id}}">Эффект</label>
              <textarea id="pg-skill-range-text-{{document.id}}" class="pg-weapon-effect-add-text" rows="2"></textarea>
            </div>
            <button type="button" class="pg-weapon-effect-add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Диапазон</button>
          </div>

          {{#if effectRanges.length}}
            <div class="pg-effect-modifier-list pg-range-list">
              {{#each effectRanges}}
                <div class="pg-effect-modifier-row pg-weapon-effect-row" data-effect-range-index="{{this.index}}">
                  <div class="pg-weapon-effect-row__range-fields">
                    <input type="number" class="pg-weapon-effect-row__from" min="1" step="1" value="{{this.from}}" aria-label="От">
                    <span>—</span>
                    <input type="number" class="pg-weapon-effect-row__to" min="1" step="1" value="{{this.to}}" aria-label="До">
                  </div>
                  <textarea class="pg-weapon-effect-row__text" rows="2" aria-label="Эффект диапазона">{{this.effect}}</textarea>
                  <button type="button" class="pg-effect-modifier-delete pg-weapon-effect-delete pg-icon-button" data-effect-range-index="{{this.index}}" title="Удалить диапазон" aria-label="Удалить диапазон"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="pg-empty">Диапазоны дополнительных эффектов не добавлены</p>
          {{/if}}
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Описание</h2>
          <div class="pg-form-field">
            <label class="pg-visually-hidden" for="pg-skill-description-{{document.id}}">Описание</label>
            <textarea id="pg-skill-description-{{document.id}}" name="system.description" rows="6">{{system.description}}</textarea>
          </div>
        </section>
        {{else}}
        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Характеристики</h2>
          <dl class="pg-specs">
            <div class="pg-specs__row"><dt>Урон</dt><dd>{{skillView.damageDie}}</dd></div>
            <div class="pg-specs__row"><dt>Куб доп. эффекта</dt><dd>{{skillView.effectCheckDie}}</dd></div>
            <div class="pg-specs__row"><dt>Очки навыков для изучения</dt><dd>{{skillView.cost}}</dd></div>
            <div class="pg-specs__row"><dt>Шаблон области</dt><dd>{{skillView.template}}</dd></div>
          </dl>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Дополнительные эффекты</h2>
          {{#if skillView.effectRanges.length}}
          <table class="pg-range-table">
            <thead><tr><th scope="col">{{skillView.effectCheckDie}}</th><th scope="col">Эффект</th></tr></thead>
            <tbody>
              {{#each skillView.effectRanges}}
              <tr><td>{{this.from}}–{{this.to}}</td><td>{{#if this.hasText}}{{this.effect}}{{else}}—{{/if}}</td></tr>
              {{/each}}
            </tbody>
          </table>
          {{else}}
          <p class="pg-empty">Диапазоны не заданы</p>
          {{/if}}
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Описание</h2>
          <div class="pg-prose">{{skillView.description}}</div>
        </section>
        {{/if}}
      </div>

      <footer class="pg-titleblock pg-titleblock--passport" aria-hidden="true">
        <div class="pg-titleblock__art pg-ornament pg-ornament--caliper"></div>
        <div class="pg-titleblock__grid">
          <span class="pg-titleblock__key">Приём</span>
          <span class="pg-titleblock__value">{{document.name}}</span>
          <span class="pg-titleblock__title"><b>Паров-Град</b><small>Наставление</small></span>
          <span class="pg-titleblock__key">Тип</span>
          <span class="pg-titleblock__value">Навык</span>
          <span class="pg-titleblock__key">Режим</span>
          <span class="pg-titleblock__value">{{#if isEditMode}}правка{{else}}просмотр{{/if}}</span>
          <span class="pg-titleblock__meta"><small>Лит.</small>Н</span>
          <span class="pg-titleblock__meta"><small>Лист</small>1</span>
          <span class="pg-titleblock__meta"><small>Шифр</small>{{passport.code}}</span>
        </div>
      </footer>
    </div>
  </div>
</section>
