<section class="pg-sheet pg-item-dossier pg-passport pg-passport--weapon">
  <div class="sheet-body">
    <div class="pg-blueprint pg-blueprint--passport">
      <div class="pg-blueprint__zones" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span></div>
      <div class="pg-blueprint__margin" aria-hidden="true"><span>Инв. № подл.</span><span>Подп. и дата</span></div>

      <header class="pg-passport__header">
        <div class="pg-passport__kicker"><span>Паров-Град</span><i class="fa-solid fa-gear" aria-hidden="true"></i><span>Технический паспорт · Оружие</span></div>
        <div class="pg-passport__figure">
          <button type="button" class="pg-item-portrait-edit" title="Изменить изображение" aria-label="Изменить изображение: {{document.name}}" {{#unless canEditPortrait}}disabled{{/unless}}>
            <img src="{{document.img}}" alt="{{document.name}}">
          </button>
          <span class="pg-passport__dim pg-passport__dim--h" aria-hidden="true">М 1:1</span>
          <span class="pg-passport__dim pg-passport__dim--v" aria-hidden="true"></span>
          <span class="pg-passport__stamp {{#if isEditMode}}is-draft{{/if}}" aria-hidden="true">{{#if isEditMode}}Черновик{{else}}Утверждено{{/if}}</span>
        </div>
        <div class="pg-passport__title">
          <h1>{{document.name}}</h1>
          <p class="pg-passport__lead">Урон: <strong>{{#if damageSummary}}{{damageSummary}}{{else}}—{{/if}}</strong></p>
          <div class="pg-passport__controls">
            <label class="pg-switch">
              <input type="checkbox" class="pg-item-equipped" {{#if equipped}}checked{{/if}} {{#unless canToggleEquipped}}disabled{{/unless}}>
              <span class="pg-switch__lever" aria-hidden="true"></span>
              <span class="pg-switch__text"><strong>Надет / используется</strong><small>Включает пассивные эффекты у носителя</small></span>
            </label>
            {{#if passport.canToggleMode}}
            <button type="button" class="pg-mode-toggle" aria-pressed="{{#if isEditMode}}true{{else}}false{{/if}}">
              {{#if isEditMode}}<i class="fa-solid fa-check" aria-hidden="true"></i> Готово{{else}}<i class="fa-solid fa-pen-ruler" aria-hidden="true"></i> Править{{/if}}
            </button>
            {{/if}}
          </div>
        </div>
      </header>

      <div class="pg-passport__body">
        {{#if isEditMode}}
        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Основные данные</h2>
          <div class="pg-form-field">
            <label for="pg-weapon-name-{{document.id}}">Название</label>
            <input id="pg-weapon-name-{{document.id}}" type="text" name="name" value="{{document.name}}" />
          </div>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Урон</h2>
          <div class="pg-form-field pg-damage-editor">
            <p class="pg-form-hint">Выберите дробящий, колющий, режущий или другой тип урона. Для смешанного урона добавьте компонент.</p>
            {{#each damageParts}}
              <div class="pg-damage-row" data-damage-index="{{@index}}">
                <input class="pg-damage-formula" type="text" value="{{this.formula}}" placeholder="1d8" title="Формула урона" aria-label="Формула урона" />
                <select class="pg-damage-type" aria-label="Тип урона">
                  {{#unless this.damageType}}<option value="" selected disabled>— Выберите тип —</option>{{/unless}}
                  {{#each this.damageTypeOptions}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
                <button type="button" class="pg-damage-delete" title="Удалить компонент" aria-label="Удалить компонент урона">×</button>
              </div>
            {{/each}}
            <button type="button" class="pg-damage-add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить компонент</button>
          </div>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Дополнительный эффект</h2>
          <div class="pg-form-field">
            <label for="pg-weapon-die-{{document.id}}">Куб проверки доп. эффекта</label>
            <select id="pg-weapon-die-{{document.id}}" name="system.effectCheckDie">
              {{#each effectDieOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            <p class="pg-form-hint">После успешной атаки и броска урона система дополнительно бросит этот куб и определит сработавший эффект по диапазону.</p>
          </div>

          <div class="pg-range-composer">
            <div class="pg-form-field">
              <label for="pg-weapon-range-from-{{document.id}}">От</label>
              <input id="pg-weapon-range-from-{{document.id}}" type="number" class="pg-weapon-effect-add-from" min="1" step="1" value="1" />
            </div>
            <div class="pg-form-field">
              <label for="pg-weapon-range-to-{{document.id}}">До</label>
              <input id="pg-weapon-range-to-{{document.id}}" type="number" class="pg-weapon-effect-add-to" min="1" step="1" value="1" />
            </div>
            <div class="pg-form-field pg-range-composer__text">
              <label for="pg-weapon-range-text-{{document.id}}">Эффект</label>
              <textarea id="pg-weapon-range-text-{{document.id}}" class="pg-weapon-effect-add-text" rows="2"></textarea>
            </div>
            <button type="button" class="pg-weapon-effect-add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Диапазон</button>
          </div>
          <p class="pg-form-hint">Пример: для D4 можно задать 1–2 = «Эффект 1», 3–4 = «Эффект 2».</p>

          {{#if effectRanges.length}}
            <div class="pg-effect-modifier-list pg-range-list">
              {{#each effectRanges}}
                <div class="pg-effect-modifier-row pg-weapon-effect-row" data-effect-range-index="{{this.index}}">
                  <div class="pg-weapon-effect-row__range-fields">
                    <input type="number" class="pg-weapon-effect-row__from" min="1" step="1" value="{{this.from}}" aria-label="От">
                    <span>—</span>
                    <input type="number" class="pg-weapon-effect-row__to" min="1" step="1" value="{{this.to}}" aria-label="До">
                  </div>
                  <textarea class="pg-weapon-effect-row__text" rows="2" aria-label="Эффект диапазона">{{this.effect}}</textarea>
                  <button type="button" class="pg-effect-modifier-delete pg-weapon-effect-delete pg-icon-button" data-effect-range-index="{{this.index}}" title="Удалить диапазон" aria-label="Удалить диапазон"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="pg-empty">Диапазоны дополнительных эффектов не добавлены</p>
          {{/if}}
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Описание</h2>
          <div class="pg-form-field">
            <label class="pg-visually-hidden" for="pg-weapon-description-{{document.id}}">Описание</label>
            <textarea id="pg-weapon-description-{{document.id}}" name="system.description" rows="6">{{system.description}}</textarea>
          </div>
        </section>
        {{else}}
        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Технические характеристики</h2>
          <dl class="pg-specs">
            <div class="pg-specs__row"><dt>Урон</dt><dd>{{weaponView.damageDie}}</dd></div>
            <div class="pg-specs__row"><dt>Куб доп. эффекта</dt><dd>{{weaponView.effectCheckDie}}</dd></div>
            <div class="pg-specs__row"><dt>Состояние</dt><dd>{{#if equipped}}в руках{{else}}в снаряжении{{/if}}</dd></div>
          </dl>
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Дополнительные эффекты</h2>
          {{#if weaponView.effectRanges.length}}
          <table class="pg-range-table">
            <thead><tr><th scope="col">{{weaponView.effectCheckDie}}</th><th scope="col">Эффект</th></tr></thead>
            <tbody>
              {{#each weaponView.effectRanges}}
              <tr><td>{{this.from}}–{{this.to}}</td><td>{{#if this.hasText}}{{this.effect}}{{else}}—{{/if}}</td></tr>
              {{/each}}
            </tbody>
          </table>
          {{else}}
          <p class="pg-empty">Диапазоны не заданы</p>
          {{/if}}
        </section>

        <section class="pg-doc-section">
          <h2 class="pg-doc-heading">Описание</h2>
          <div class="pg-prose">{{weaponView.description}}</div>
        </section>
        {{/if}}

        <section class="pg-doc-section pg-doc-section--effects">
          <h2 class="pg-doc-heading">Эффекты предмета</h2>
          <div class="pg-item-effects">
            {{#each itemEffectGroups}}
              <section class="pg-item-effect-group {{#if this.isEditable}}pg-item-effect-group--editable{{/if}}" data-item-effect-application="{{this.application}}">
                <div class="pg-item-effect-group__heading">
                  <h3>{{this.label}}</h3>
                  {{#if this.isEditable}}
                    <button type="button" class="pg-item-effect-create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Создать эффект</button>
                  {{/if}}
                </div>
                <p class="pg-form-hint">{{this.hint}}</p>
                {{#if this.isEditable}}
                  <p class="pg-item-effect-drop-hint"><i class="fa-solid fa-hand" aria-hidden="true"></i> Перетащите сюда готовый эффект</p>
                {{/if}}
                {{#if this.effects.length}}
                  <div class="pg-item-effect-list">
                    {{#each this.effects}}
                      <article class="pg-item-effect-row {{#if this.disabled}}pg-item-effect-row--disabled{{/if}}" data-effect-id="{{this.id}}">
                        <img class="pg-item-effect-row__icon" src="{{this.img}}" alt="">
                        <div class="pg-item-effect-row__body">
                          <strong>{{this.name}}</strong>
                          {{#if this.disabled}}<span class="pg-item-effect-status">Отключён</span>{{/if}}
                          {{#if this.modifierSummary}}<p>{{this.modifierSummary}}</p>{{/if}}
                          {{#if this.impact}}<p>{{this.impact}}</p>{{/if}}
                          {{#if this.removal}}<p>Снятие: {{this.removal}}</p>{{/if}}
                          {{#if this.description}}<p>{{this.description}}</p>{{/if}}
                          {{#if ../isEditable}}
                            <select class="pg-item-effect-mode" aria-label="Способ применения эффекта {{this.name}}">
                              <option value="passive" {{#if this.isPassive}}selected{{/if}}>Пассивный — носителю</option>
                              <option value="active" {{#unless this.isPassive}}selected{{/unless}}>Активный — цели</option>
                            </select>
                          {{/if}}
                        </div>
                        {{#if ../isEditable}}
                          <div class="pg-item-effect-row__actions">
                            <button type="button" class="pg-item-effect-edit" title="Редактировать эффект" aria-label="Редактировать {{this.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                            <button type="button" class="pg-item-effect-toggle" title="{{#if this.disabled}}Включить{{else}}Отключить{{/if}} эффект" aria-label="{{#if this.disabled}}Включить{{else}}Отключить{{/if}} {{this.name}}"><i class="fa-solid {{#if this.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" aria-hidden="true"></i></button>
                            <button type="button" class="pg-item-effect-delete" title="Удалить привязку" aria-label="Удалить {{this.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                          </div>
                        {{/if}}
                      </article>
                    {{/each}}
                  </div>
                {{else}}
                  <p class="pg-empty">Эффекты не добавлены</p>
                {{/if}}
              </section>
            {{/each}}
          </div>
        </section>
      </div>

      <footer class="pg-titleblock pg-titleblock--passport" aria-hidden="true">
        <div class="pg-titleblock__art pg-ornament pg-ornament--caliper"></div>
        <div class="pg-titleblock__grid">
          <span class="pg-titleblock__key">Изделие</span>
          <span class="pg-titleblock__value">{{document.name}}</span>
          <span class="pg-titleblock__title"><b>Паров-Град</b><small>Технический паспорт</small></span>
          <span class="pg-titleblock__key">Тип</span>
          <span class="pg-titleblock__value">Оружие</span>
          <span class="pg-titleblock__key">Режим</span>
          <span class="pg-titleblock__value">{{#if isEditMode}}правка{{else}}просмотр{{/if}}</span>
          <span class="pg-titleblock__meta"><small>Лит.</small>О</span>
          <span class="pg-titleblock__meta"><small>Лист</small>1</span>
          <span class="pg-titleblock__meta"><small>Шифр</small>{{passport.code}}</span>
        </div>
      </footer>
    </div>
  </div>
</section>
