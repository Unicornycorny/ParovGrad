<section class="pg-sheet pg-item-dossier">
  <div class="sheet-body">
    <header class="pg-sheet-header">
      <button type="button" class="pg-item-portrait-edit" title="Изменить изображение" aria-label="Изменить изображение: {{document.name}}" {{#unless canEditPortrait}}disabled{{/unless}}>
        <img src="{{document.img}}" alt="{{document.name}}">
      </button>
      <div class="pg-item-dossier-heading"><div class="pg-item-dossier-kicker">Паров-Град · Предмет</div>
        <h1>{{document.name}}</h1></div>
      <div class="pg-item-sheet-mode">
        {{#if isEditMode}}
          Режим: редактирование
        {{else}}
          Режим: просмотр
        {{/if}}
      </div>
    </header>

    <div class="pg-item-equipped-field">
      <label>
        <input type="checkbox" class="pg-item-equipped" {{#if equipped}}checked{{/if}} {{#unless canToggleEquipped}}disabled{{/unless}}>
        <strong>Надет / используется</strong>
      </label>
      <p class="pg-form-hint">Включает пассивные эффекты у носителя. Хранение в инвентаре их не включает.</p>
    </div>

    <div class="pg-item-effects">
      {{#each itemEffectGroups}}
        <section class="pg-item-effect-group {{#if this.isEditable}}pg-item-effect-group--editable{{/if}}" data-item-effect-application="{{this.application}}">
          <div class="pg-item-effect-group__heading">
            <h2>{{this.label}}</h2>
            {{#if this.isEditable}}
              <button type="button" class="pg-item-effect-create"><i class="fa-solid fa-plus"></i> Создать эффект</button>
            {{/if}}
          </div>
          <p class="pg-form-hint">{{this.hint}}</p>
          {{#if this.isEditable}}
            <p class="pg-item-effect-drop-hint"><i class="fa-solid fa-hand"></i> Перетащите сюда готовый эффект</p>
          {{/if}}
          {{#if this.effects.length}}
            <div class="pg-item-effect-list">
              {{#each this.effects}}
                <article class="pg-item-effect-row {{#if this.disabled}}pg-item-effect-row--disabled{{/if}}" data-effect-id="{{this.id}}">
                  <img class="pg-item-effect-row__icon" src="{{this.img}}" alt="">
                  <div class="pg-item-effect-row__body">
                    <strong>{{this.name}}</strong>
                    {{#if this.disabled}}<span class="pg-item-effect-status">Отключён</span>{{/if}}
                    {{#if this.modifierSummary}}<p>{{this.modifierSummary}}</p>{{/if}}
                    {{#if this.impact}}<p>{{this.impact}}</p>{{/if}}
                    {{#if this.removal}}<p>Снятие: {{this.removal}}</p>{{/if}}
                    {{#if this.description}}<p>{{this.description}}</p>{{/if}}
                    {{#if ../isEditable}}
                      <select class="pg-item-effect-mode" aria-label="Способ применения эффекта {{this.name}}">
                        <option value="passive" {{#if this.isPassive}}selected{{/if}}>Пассивный — носителю</option>
                        <option value="active" {{#unless this.isPassive}}selected{{/unless}}>Активный — цели</option>
                      </select>
                    {{/if}}
                  </div>
                  {{#if ../isEditable}}
                    <div class="pg-item-effect-row__actions">
                      <button type="button" class="pg-item-effect-edit" title="Редактировать эффект" aria-label="Редактировать {{this.name}}"><i class="fa-solid fa-pen"></i></button>
                      <button type="button" class="pg-item-effect-toggle" title="{{#if this.disabled}}Включить{{else}}Отключить{{/if}} эффект" aria-label="{{#if this.disabled}}Включить{{else}}Отключить{{/if}} {{this.name}}"><i class="fa-solid {{#if this.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></button>
                      <button type="button" class="pg-item-effect-delete" title="Удалить привязку" aria-label="Удалить {{this.name}}"><i class="fa-solid fa-trash"></i></button>
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="pg-effect-modifier-empty">Эффекты не добавлены</div>
          {{/if}}
        </section>
      {{/each}}
    </div>

    {{#if isEditMode}}
      <div class="pg-form-field">
        <label>Название</label>
        <input type="text" name="name" value="{{document.name}}" />
      </div>

      <div class="pg-form-field">
        <label>Куб проверки доп. эффекта</label>
        <select name="system.effectCheckDie">
          {{#each effectDieOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <p class="pg-form-hint">После использования предмета можно отдельно проверить дополнительный эффект по диапазону.</p>
      </div>

      <div class="pg-form-field">
        <label>Диапазоны дополнительных эффектов</label>

        <div class="pg-form-grid pg-form-grid--two-columns">
          <div class="pg-form-field">
            <label>От</label>
            <input type="number" class="pg-weapon-effect-add-from" min="1" step="1" value="1" />
          </div>

          <div class="pg-form-field">
            <label>До</label>
            <input type="number" class="pg-weapon-effect-add-to" min="1" step="1" value="1" />
          </div>
        </div>

        <div class="pg-form-field">
          <label>Эффект</label>
          <textarea class="pg-weapon-effect-add-text" rows="3"></textarea>
        </div>

        <button type="button" class="pg-weapon-effect-add">+ Добавить диапазон</button>

        {{#if effectRanges.length}}
          <div class="pg-effect-modifier-list">
            {{#each effectRanges}}
              <div class="pg-effect-modifier-row pg-weapon-effect-row" data-effect-range-index="{{this.index}}">
                <div class="pg-effect-modifier-row__label">Диапазон</div>
                <div class="pg-weapon-effect-row__range-fields">
                  <input
                    type="number"
                    class="pg-weapon-effect-row__from"
                    min="1"
                    step="1"
                    value="{{this.from}}"
                  >
                  <span>—</span>
                  <input
                    type="number"
                    class="pg-weapon-effect-row__to"
                    min="1"
                    step="1"
                    value="{{this.to}}"
                  >
                </div>
                <textarea
                  class="pg-weapon-effect-row__text"
                  rows="2"
                >{{this.effect}}</textarea>
                <button type="button" class="pg-effect-modifier-delete pg-weapon-effect-delete" data-effect-range-index="{{this.index}}">Удалить</button>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="pg-effect-modifier-empty">Диапазоны дополнительных эффектов не добавлены</div>
        {{/if}}
      </div>

      <div class="pg-form-field">
        <label>Описание</label>
        <textarea name="system.description">{{system.description}}</textarea>
      </div>
    {{else}}
      <div class="pg-weapon-stat-grid">
        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">Название</div>
          <div class="pg-weapon-stat__value">{{itemView.name}}</div>
        </article>

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">Куб доп. эффекта</div>
          <div class="pg-weapon-stat__value">{{itemView.effectCheckDie}}</div>
        </article>

        <article class="pg-weapon-stat pg-weapon-stat--full">
          <div class="pg-weapon-stat__label">Диапазоны доп. эффектов</div>
          <div class="pg-weapon-stat__value">
            {{#if itemView.effectRanges.length}}
              <div class="pg-effect-modifier-readonly-list">
                {{#each itemView.effectRanges}}
                  <div class="pg-effect-modifier-readonly-row">
                    <span>{{this.from}}–{{this.to}}</span>
                    <strong>{{#if this.hasText}}{{this.effect}}{{else}}—{{/if}}</strong>
                  </div>
                {{/each}}
              </div>
            {{else}}
              —
            {{/if}}
          </div>
        </article>

        <article class="pg-weapon-stat pg-weapon-stat--full">
          <div class="pg-weapon-stat__label">Описание</div>
          <div class="pg-weapon-stat__value">{{itemView.description}}</div>
        </article>
      </div>
    {{/if}}
  </div>
</section>
