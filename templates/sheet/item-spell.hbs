<section class="pg-sheet">
  <div class="sheet-body">

    <header class="pg-sheet-header">
      <h1>{{document.name}}</h1>

      <div class="pg-item-sheet-mode">
        {{#if isEditMode}}
          Режим: редактирование
        {{else}}
          Режим: просмотр
        {{/if}}
      </div>
    </header>

    <div class="pg-spell-builder-callout">
      <div>
        <strong>Конструктор заклинания</strong>
        <span>Выберите составляющие прямо на древе магии и примените рассчитанный результат.</span>
      </div>
      <button type="button" class="pg-spell-open-builder">
        <i class="fa-solid fa-diagram-project"></i>
        Собрать из древа
      </button>
    </div>

    {{#if constructionStatus.hasConstruction}}
      <div class="pg-spell-construction-status {{#if constructionStatus.outdated}}is-outdated{{/if}} {{#unless constructionStatus.treeAvailable}}is-missing{{/unless}}">
        <i class="fa-solid fa-code-branch"></i>
        <div>
          {{#if constructionStatus.treeAvailable}}
            <strong>{{constructionStatus.treeName}}</strong>
            <span>
              Ревизия сборки: {{constructionStatus.treeRevision}} · Узлов: {{constructionStatus.selectedNodeIds.length}}
              {{#if constructionStatus.outdated}}
                · Текущая ревизия древа: {{constructionStatus.currentTreeRevision}}
              {{/if}}
            </span>
            {{#if constructionStatus.outdated}}
              <small>Древо изменилось. Текущие параметры заклинания сохранены как snapshot и не меняются автоматически.</small>
            {{/if}}
          {{else}}
            <strong>Исходное древо недоступно</strong>
            <span>Сохранён UUID: {{constructionStatus.treeUuid}}</span>
          {{/if}}
        </div>
      </div>
    {{/if}}

    {{#if isEditMode}}

      <div class="pg-form-field">
        <label>Название</label>
        <input
          type="text"
          name="name"
          value="{{document.name}}"
        />
      </div>

      <div class="pg-form-grid pg-form-grid--two-columns">

        <div class="pg-form-field">
          <label>Уровень</label>
          <input
            type="number"
            name="system.level"
            min="0"
            step="1"
            value="{{system.level}}"
          />
        </div>

        <div class="pg-form-field">
          <label>Стоимость</label>
          <input
            type="number"
            name="system.cost"
            min="0"
            step="1"
            value="{{system.cost}}"
          />
        </div>

        <div class="pg-form-field">
          <label>Дальность</label>
          <input
            type="text"
            name="system.range"
            value="{{system.range}}"
          />
        </div>

        <div class="pg-form-field">
          <label>Форма</label>
          <input
            type="text"
            name="system.shape"
            value="{{system.shape}}"
          />
        </div>

      </div>

      <div class="pg-form-field">
        <label>Влияние</label>

        {{#if canAddInfluence}}
          <div class="pg-spell-influence-add-row">
            <input
              type="text"
              class="pg-spell-influence-add-input"
              placeholder="Тип влияния"
            />

            <button
              type="button"
              class="pg-spell-influence-add"
            >
              + Добавить
            </button>
          </div>
        {{/if}}

        <p class="pg-form-hint">
          Можно указать до 4 типов влияния.
        </p>

        {{#if influenceList}}
          <div class="pg-effect-modifier-list">

            {{#each influenceList}}
              <div class="pg-spell-influence-row">

                <input
                  type="text"
                  class="pg-spell-influence-value"
                  data-influence-index="{{this.index}}"
                  value="{{this.value}}"
                />

                <button
                  type="button"
                  class="pg-effect-modifier-delete pg-spell-influence-delete"
                  data-influence-index="{{this.index}}"
                >
                  Удалить
                </button>

              </div>
            {{/each}}

          </div>
        {{else}}
          <div class="pg-effect-modifier-empty">
            Влияния не добавлены
          </div>
        {{/if}}
      </div>

      <div class="pg-form-field">
        <label>Материальные компоненты</label>
        <textarea
          class="pg-spell-materials-input"
          rows="4"
          placeholder="Один компонент на строку"
        >{{materialsText}}</textarea>
        <p class="pg-form-hint">Пока это обычный текст. При сборке из древа значения берутся из выбранных узлов.</p>
      </div>

      <div class="pg-form-field">
        <label>Описание</label>
        <textarea
          name="system.description"
          rows="5"
        >{{system.description}}</textarea>
      </div>

    {{else}}

      <div class="pg-weapon-stat-grid">

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">
            Название
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.name}}
          </div>
        </article>

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">
            Уровень
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.level}}
          </div>
        </article>

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">
            Стоимость
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.cost}}
          </div>
        </article>

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">
            Дальность
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.range}}
          </div>
        </article>

        <article class="pg-weapon-stat">
          <div class="pg-weapon-stat__label">
            Форма
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.shape}}
          </div>
        </article>

        <article class="pg-weapon-stat pg-weapon-stat--full">
          <div class="pg-weapon-stat__label">
            Влияние
          </div>

          <div class="pg-weapon-stat__value">

            {{#if spellView.influences}}
              <div class="pg-effect-modifier-readonly-list">

                {{#each spellView.influences}}
                  <div class="pg-effect-modifier-readonly-row">
                    <strong>{{this}}</strong>
                  </div>
                {{/each}}

              </div>
            {{else}}
              —
            {{/if}}

          </div>
        </article>

        <article class="pg-weapon-stat pg-weapon-stat--full">
          <div class="pg-weapon-stat__label">
            Материальные компоненты
          </div>
          <div class="pg-weapon-stat__value">
            {{#if spellView.materials}}
              <div class="pg-effect-modifier-readonly-list">
                {{#each spellView.materials}}
                  <div class="pg-effect-modifier-readonly-row">{{this}}</div>
                {{/each}}
              </div>
            {{else}}
              —
            {{/if}}
          </div>
        </article>

        <article class="pg-weapon-stat pg-weapon-stat--full">
          <div class="pg-weapon-stat__label">
            Описание
          </div>
          <div class="pg-weapon-stat__value">
            {{spellView.description}}
          </div>
        </article>

      </div>

    {{/if}}

  </div>
</section>
