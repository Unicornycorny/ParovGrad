<section class="pg-sheet pg-player-dossier">
  <div class="sheet-body">
    <header class="pg-dossier-header">
      <figure class="pg-dossier-portrait">
        <img src="{{document.img}}" alt="Портрет: {{document.name}}">
      </figure>
      <div class="pg-dossier-identity">
        <div class="pg-dossier-kicker">Личное дело <span aria-hidden="true">◆</span> Лист персонажа</div>
        <div class="pg-dossier-brand" aria-hidden="true">Паров-Град</div>
        <h1>{{document.name}}</h1>
      </div>
      <div class="pg-dossier-seal" aria-hidden="true">ПГ</div>
    </header>

    <section class="pg-dossier-section pg-dossier-stats">
      <h2>Характеристики</h2>
      <div class="pg-dossier-stat-grid">

      {{#each statViews}}
      <div class="pg-stat-row">
        <label for="pg-stat-{{this.key}}">{{this.label}}</label>
        <div class="pg-stat-controls pg-stat-controls--with-influence">
          <input id="pg-stat-{{this.key}}" type="number" name="system.stats.{{this.key}}" min="1" max="20"
            value="{{this.value}}">
          <input type="text" class="pg-stat-influence" value="{{this.influenceDisplay}}" readonly disabled tabindex="-1"
            title="{{this.influenceTooltip}}" aria-label="Сумма внешних влияний: {{this.influenceDisplay}}">
          <button type="button" class="pg-stat-roll" data-stat-key="{{this.key}}"
            aria-label="Проверка характеристики {{this.label}}"
            title="Проверка характеристики {{this.label}} (итог: {{this.effectiveValue}})">
            D20
          </button>
        </div>
      </div>
      {{/each}}
      </div>
    </section>

    <section class="pg-dossier-section pg-dossier-resources">
      <h2>Показатели</h2>
      <div class="pg-dossier-resource-grid">

      <div class="pg-dossier-field">
        <label for="pg-life-path">Жизненный путь</label>
        <input id="pg-life-path" type="number" name="system.lifePath" min="1" max="5" value="{{system.lifePath}}">
      </div>

      <div class="pg-dossier-field">
        <label>Вдохновение</label>
        <input type="number" name="system.inspiration" min="0" value="{{system.inspiration}}">
      </div>

      <div class="pg-dossier-field">
        <label>Очки навыков</label>
        <input type="number" name="system.skillPoints" min="0" step="1" value="{{system.skillPoints}}">
      </div>

      <div class="pg-dossier-field">
        <label>Опыт</label>
        <input type="number" name="system.experience" min="0" value="{{system.experience}}">
      </div>

      <div class="pg-dossier-field pg-dossier-level">
        <label>Уровень</label>
        <div class="pg-level-up-controls">
          <input type="number" name="system.level" min="0" value="{{system.level}}">
          <button type="button" class="pg-level-up-button">Повысить уровень</button>
        </div>
      </div>

      <div class="pg-dossier-field pg-dossier-health-influence">
        <label>Внешнее влияние на макс. здоровье</label>
        <input type="text" class="pg-stat-influence" value="{{healthInfluenceView.influenceDisplay}}" readonly disabled
          tabindex="-1" title="{{healthInfluenceView.influenceTooltip}}">
      </div>

      <div class="pg-dossier-field pg-dossier-health">
        <label>Здоровье</label>
        <div class="pg-dossier-health-values">
        <input type="number" name="system.health.value" min="0" max="{{derivedHealthMax}}"
          value="{{system.health.value}}">
        /
        <input type="number" value="{{derivedHealthMax}}" disabled aria-label="Максимальное здоровье">
        </div>
      </div>
      </div>
    </section>

    <section class="pg-dossier-section pg-dossier-effects">
      <div class="pg-section-header">
        <h2>Эффекты</h2>
        <button type="button" class="pg-effect-create">+ Добавить эффект</button>
      </div>

      <p class="pg-form-hint">Можно добавить эффект кнопкой или перетащить на лист/токен шаблон эффекта либо уже
        существующий активный эффект.</p>

      {{#if effects.length}}
      <ul class="pg-effect-list">
        {{#each effects}}
        <li class="pg-effect-row {{#if this.disabled}}is-disabled{{/if}}" data-effect-id="{{this.id}}" draggable="true">
          <img class="pg-effect-row__icon" src="{{this.img}}" alt="{{this.name}}">

          <div class="pg-effect-row__content">
            <div class="pg-effect-row__title-line">
              <button type="button" class="pg-effect-edit pg-effect-row__name"
                data-effect-id="{{this.id}}">{{this.name}}</button>
              {{#if this.disabled}}<span class="pg-effect-badge">Выключен</span>{{/if}}
            </div>

            <div class="pg-effect-row__meta">
              <span>Уровень: {{this.level}}</span>
              <span>Тип: {{#if this.effectType}}{{this.effectType}}{{else}}—{{/if}}</span>
              <span>Изменений: {{this.changesCount}}</span>
            </div>

            {{#if this.impact}}
            <div class="pg-effect-row__text"><strong>Воздействие:</strong> {{this.impact}}</div>
            {{/if}}

            {{#if this.removal}}
            <div class="pg-effect-row__text"><strong>Снятие:</strong> {{this.removal}}</div>
            {{/if}}

            {{#if this.modifierSummary}}
            <div class="pg-effect-row__text"><strong>Влияния:</strong> {{this.modifierSummary}}</div>
            {{/if}}

            {{#if this.sourceLabel}}
            <div class="pg-effect-row__source">Шаблон: {{this.sourceLabel}}</div>
            {{/if}}
          </div>

          <div class="pg-effect-row__actions">
            <button type="button" class="pg-effect-toggle" data-effect-id="{{this.id}}">{{#if
              this.disabled}}Включить{{else}}Выключить{{/if}}</button>
            <button type="button" class="pg-effect-edit" data-effect-id="{{this.id}}">Изменить</button>
            <button type="button" class="pg-effect-delete" data-effect-id="{{this.id}}">Удалить</button>
          </div>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p>Нет активных эффектов</p>
      {{/if}}
    </section>

    <section class="pg-dossier-section pg-dossier-items">
      <h2>Предметы</h2>
      <div class="pg-item-category-menu">
        <label>Категория
          <select class="pg-item-category" aria-label="Категория предметов">
            {{#each itemCategories}}
            <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}} ({{this.count}})</option>
            {{/each}}
          </select>
        </label>
      </div>

      {{#if items.length}}
      <ul class="pg-item-list">
        {{#each items}}
        <li class="pg-item-row">
          <img class="pg-dossier-item-icon" src="{{this.img}}" alt="" loading="lazy">
          <button type="button" class="pg-item-link" data-item-id="{{this.id}}">
            {{this.name}}
          </button>

          <button type="button" class="pg-item-roll" data-item-id="{{this.id}}" aria-label="Использовать предмет"
            title="Использовать предмет">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path
                d="M11.2 2.3a2 2 0 0 1 1.6 0l7 3.1A2 2 0 0 1 21 7.2v9.6a2 2 0 0 1-1.2 1.8l-7 3.1a2 2 0 0 1-1.6 0l-7-3.1A2 2 0 0 1 3 16.8V7.2a2 2 0 0 1 1.2-1.8l7-3.1ZM8.1 5.1l3.9 1.7 3.9-1.7L12 3.4 8.1 5.1Zm9.9 2.3-4 1.8v4.1l4-1.8V7.4Zm-12 0v4.1l4 1.8V9.2l-4-1.8Zm4 13.1v-4.1l-4-1.8v4.1l4 1.8Zm4 0 4-1.8v-4.1l-4 1.8v4.1Z" />
            </svg>
          </button>

          <button type="button" class="pg-item-delete" data-item-id="{{this.id}}" aria-label="Удалить предмет"
            title="Удалить предмет">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path
                d="M9 3h6l1 2h4v2H4V5h4l1-2zm1 6h2v8h-2V9zm4 0h2v8h-2V9zM7 9h2v8H7V9zm-1 12h12a2 2 0 0 0 2-2V7H4v12a2 2 0 0 0 2 2z" />
            </svg>
          </button>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p>{{itemCategoryEmpty}}</p>
      {{/if}}
    </section>
    {{#if legacyMagicTrees.length}}
    <section class="pg-dossier-section pg-legacy-trees">
      <h2>Ранее добавленные древа магии</h2>
      <p class="pg-form-hint">Древа магии должны храниться в каталоге предметов мира. Эти старые записи оставлены для сохранения данных: перед удалением экспортируйте их через меню листа.</p>
      <ul class="pg-item-list">
        {{#each legacyMagicTrees}}
        <li class="pg-item-row">
          <button type="button" class="pg-item-link" data-item-id="{{this.id}}">{{this.name}}</button>
          <button type="button" class="pg-item-delete pg-legacy-tree-delete" data-item-id="{{this.id}}" aria-label="Удалить древо магии">Удалить</button>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/if}}
    <footer class="pg-dossier-footer" aria-hidden="true"><span>Паров-Град</span><span>◆</span><span>Личное дело</span></footer>
  </div>
</section>